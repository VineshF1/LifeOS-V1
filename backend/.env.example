# Copy to backend/.env and fill in real values.

# --- Database (Neon) -------------------------------------------------------
# Paste the connection string from the Neon console. Either the pooled
# ("-pooler") host or the direct host works; the app disables statement caching
# which is what PgBouncer transaction pooling requires.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- NVIDIA NIM ------------------------------------------------------------
# From https://build.nvidia.com  (starts with nvapi-)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Auth ------------------------------------------------------------------
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# --- Optional overrides ----------------------------------------------------
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# NIM_TIMEOUT_SECONDS=15
# AGENT_MAX_ITERATIONS=4
# AGENT_TOTAL_BUDGET_SECONDS=60
# CORS_ORIGINS=http://localhost:3000
